{
	"name": "Myket APK Downloader",
	"version": "1.2.0",
	"author": "Hamidreza Bayat <hamidrezabayat76@gmail.com>",
	"description": "Download Myket apps from the browser",
	"manifest_version": 2,
	"content_scripts": [
		{
			"matches": ["*://myket.ir/app/*"],
			"js": ["scripts/content-script.js"],
			"run_at": "document_end"
		}
	],
	"permissions": ["https://myket.ir/app/*", "https://apiserver.myket.ir/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "{f321959a-a1f2-43a2-b971-481a221ccd10}",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	},
	"icons": {
		"48": "icons/48x48.png",
		"96": "icons/96x96.png"
	}
}
