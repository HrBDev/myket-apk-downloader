{
	"compilerOptions": {
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"module": "ESNext",
		"target": "ES2022",
		"esModuleInterop": true,
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "dist/js",
		"noEmitOnError": true,
		"skipLibCheck": true,
		"typeRoots": ["node_modules/@types"],
		"moduleResolution": "Bundler",
	},
	"include": [
		"src/**/*.ts"
	]
}
